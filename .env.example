# Antarctica Research Station Backend - Environment Configuration Example
# Copy this file to .env and fill in actual values for your environment

# ===========================================
# MAIN DATABASE CONFIGURATION
# ===========================================

# For local development (SQLite - default):
# DATABASE_URL=sqlite:///./antarctica_test.db

# For production/PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/antarctica_db

# For Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Leave empty to use default SQLite
DATABASE_URL=

# ===========================================
# DTN QUEUE DATABASE CONFIGURATION
# ===========================================

# DTN queue uses local SQLite for store-and-forward operation
# This should remain local even when using PostgreSQL for main database
# DTN queue must work during network outages in Antarctica

DTN_DATABASE_PATH=dtn_queue.db

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application host and port
HOST=0.0.0.0
PORT=8000

# Environment name (development, staging, production)
ENVIRONMENT=development

# ===========================================
# SECURITY NOTES
# ===========================================

# NEVER commit actual credentials to version control
# NEVER share .env files
# Use different passwords for development and production
# Rotate credentials regularly
# Use Supabase's connection pooling for production